NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push: a chave pública pode ser enviada ao navegador; a privada nunca pode.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@suzanazatorre.com.br

# O Vercel Cron envia automaticamente esta variável no cabeçalho Authorization.
CRON_SECRET=

# Segredo alternativo para chamadas manuais controladas.
PUSH_CRON_SECRET=

# Relatórios online: guardar o token somente como Secret no servidor.
META_ADS_ACCESS_TOKEN=
TRAFFIC_META_GRAPH_VERSION=v25.0

# Contratos: todos os envios e a nova fila permanecem pausados até homologação.
CONTRACTS_ENABLED=false
CONTRACT_DELIVERY_QUEUE_ENABLED=false
CONTRACT_TOKEN_SECRET=
CONTRACT_CONNECTION_TEST_ENABLED=false
CONTRACT_CONNECTION_TEST_PHONE=
CONTRACT_CONNECTION_TEST_EMAIL=
CONTRACT_CONNECTION_TEST_EXPIRES_AT=
CONTRACTS_APP_URL=https://rotina.suzanazatorre.com.br
CONTRACT_WHATSAPP_PROVIDER=disabled
CONTRACT_WHATSAPP_OTP_ENABLED=false
CONTRACT_WHATSAPP_DISPATCH_GUARD_ENABLED=false
CONTRACT_BOTCONVERSA_RELAY_ENABLED=false
CONTRACT_WHATSAPP_RELAY_SECRET=
CONTRACT_BOTCONVERSA_LINK_RECEIVER_URL=
CONTRACT_BOTCONVERSA_COPY_RECEIVER_URL=
CONTRACT_BOTCONVERSA_WEBHOOK_URL=
CONTRACT_BOTCONVERSA_WEBHOOK_TOKEN=
# Compatibilidade com a configuração atual (usada somente no provedor botconversa).
CONTRACT_WHATSAPP_WEBHOOK_URL=
# Receptor futuro: definir URL real e segredo somente depois de validar o Papo_reto.
CONTRACT_PAPO_RETO_WEBHOOK_URL=
CONTRACT_PAPO_RETO_WEBHOOK_TOKEN=
